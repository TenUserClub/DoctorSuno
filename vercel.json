{
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/api-docs",
      "destination": "/api/index"
    },
    {
      "source": "/api-docs/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/dashboard",
      "destination": "/demo/index.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/demo/index.html"
    }
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/demo",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/demo/",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/demo/index.html",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/demo/index",
      "destination": "/dashboard",
      "permanent": true
    }
  ]
}
